# Copy to server/.env and fill in. NEVER commit real secrets.

# Strong random string in production. Rotate on any suspected exposure.
JWT_SECRET=change-me-to-a-long-random-value

# Reference SQLite database path (use a durable volume in production).
DB_PATH=project-console.db

# HTTP port for the backend.
PORT=3000

# Deadline sweep interval (ms). In serverless, use an external scheduler
# calling POST /ap/deadline-sweep instead and set this high or disable.
SWEEP_INTERVAL_MS=60000

# --- Firebase target (if deploying on the blueprint's suggested stack) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# Service-account credentials belong in the server environment / secret manager,
# NEVER in the Android client or the repo.

# --- NextDNS (docs/NEXTDNS.md) ---
# AP-owned API key. Server-side ONLY: never commit it, never send it to a
# browser. On the Cloudflare Worker target: `wrangler secret put NEXTDNS_API_KEY`.
NEXTDNS_API_KEY=
# Development only: in-memory NextDNS stand-in, clearly labelled SIMULATED.
# NEXTDNS_MODE=simulated
# How often temporary access expiry + NextDNS reconciliation runs (ms).
WEB_CONTROL_SWEEP_MS=30000
# Monitoring-integrity sweep interval (ms): heartbeat staleness + throttled NextDNS checks.
INTEGRITY_SWEEP_MS=60000
